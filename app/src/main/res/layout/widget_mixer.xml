<?xml version="1.0" encoding="utf-8"?>
<!-- Dimensions sur l'échelle du design system (CLAUDE.md §7) ; boutons de 48 dp (cible tactile). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <Button
        android:id="@+id/widget_down"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:text="−"
        android:textSize="24sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_master"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/widget_preset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:textColor="#FFC6BFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/widget_up"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:text="+"
        android:textSize="24sp" />
</LinearLayout>
